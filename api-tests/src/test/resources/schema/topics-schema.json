{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Topics list (GET /static/topics/list)",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["ref", "title"],
    "properties": {
      "ref": {
        "type": "string",
        "minLength": 1
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "description": {
        "type": "string"
      }
    }
  }
}