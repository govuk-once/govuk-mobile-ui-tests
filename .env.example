# GOV.UK App credentials for sign-in flows
GOVUK_EMAIL=your-test-email@example.com
GOVUK_PASSWORD=your-test-password

# TOTP secret for 2FA (authenticator app)
# When creating your GOV.UK One Login test account, choose "authenticator app"
# for 2FA, then click "I cannot scan the QR code" to reveal the secret key.
# Paste the key here with spaces removed.
GOVUK_TOTP_SECRET=your-totp-secret-key

# Rerun failed tests once (1 = on, 0 = off, e.g. when debugging)
RETRY=1
